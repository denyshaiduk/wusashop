# Скопіюйте цей файл у .env та заповніть реальними значеннями

PORT=3000

# Пароль для входу в адмін-панель (/admin)
ADMIN_PASSWORD=change-me
# Довільний випадковий рядок для підпису сесійного токена адміна
SESSION_SECRET=change-me-too

# LiqPay (https://www.liqpay.ua/account/develop) — публічний і приватний ключі магазину
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# Публічна адреса вітрини, потрібна для result_url/server_url LiqPay
SITE_URL=http://localhost:3000
# Додатковий origin адмін-панелі, якщо вона працює не на API-домені
ADMIN_ORIGIN=

# Нова Пошта API (https://developers.novaposhta.ua/)
NOVA_POSHTA_API_KEY=

# Реквізити для оплати банківським переказом (поки не підключено LiqPay/еквайринг)
PAYMENT_RECEIVER_NAME=
PAYMENT_IBAN=
PAYMENT_TAX_ID=
PAYMENT_BANK_NAME=
PAYMENT_BANK_MFO=
PAYMENT_BANK_EDRPOU=
# Відсоток передоплати від суми замовлення
PREPAYMENT_PERCENT=30

# Telegram-сповіщення про нові замовлення (створіть бота через @BotFather,
# chat_id — канал/чат, куди бот доданий адміністратором)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
